// CURHATI — FULLSTACK SYSTEM BLUEPRINT
// Prisma Schema Definition (PostgreSQL)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  ADMIN_OPERASIONAL
  CLIENT
  ASSESSMENT_STAFF
  PSIKOLOG
  PSYCHOLOGIST
  TEMAN_CERITA
  FINANCE
  OWNER
}

enum ServiceType {
  TEMAN_CERITA
  PSIKOLOG_UMUM
  PSIKOLOG_KLINIS
}

enum ServiceCategory {
  TEMAN_CERITA
  PSIKOLOG_UMUM
  PSIKOLOG_KLINIS
}

enum ReservationStatus {
  PENDING
  PENDING_PAYMENT
  CONFIRMED
  RESCHEDULED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  ONGOING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

// ------------------------------------------------------
// USER & PROFILE (RBAC)
// ------------------------------------------------------

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String?
  phone        String?
  avatarUrl    String?
  role         Role      @default(CLIENT)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  profile      UserProfile?

  clientReservations    Reservation[]       @relation("ClientReservations")
  counselorReservations Reservation[]       @relation("CounselorReservations")
  clientSessions        CounselingSession[] @relation("ClientSessions")
  counselorSessions     CounselingSession[] @relation("CounselorSessions")
  assessments           Assessment[]
  chatMessages          ChatMessage[]
  auditLogs             AuditLog[]

  @@index([email])
  @@index([role])
}

model UserProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName       String
  phone          String?
  avatarUrl      String?
  bio            String?  @db.Text
  specialization String?
  sippNumber     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ------------------------------------------------------
// RESERVATIONS (Anti Double-Booking Engine)
// ------------------------------------------------------

model Reservation {
  id          String            @id @default(uuid())
  clientId    String
  client      User              @relation("ClientReservations", fields: [clientId], references: [id], onDelete: Cascade)
  counselorId String
  counselor   User              @relation("CounselorReservations", fields: [counselorId], references: [id], onDelete: Cascade)
  serviceType ServiceType       @default(TEMAN_CERITA)
  date        DateTime
  timeSlot    String
  totalPrice  Int
  status      ReservationStatus @default(PENDING_PAYMENT)
  clientNotes String?           @db.Text
  adminNotes  String?           @db.Text
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  payment           Payment?
  counselingSession CounselingSession?

  @@unique([counselorId, date, timeSlot])
  @@index([clientId])
  @@index([counselorId])
  @@index([date])
  @@index([status])
}

// ------------------------------------------------------
// COUNSELING SESSIONS (Private Clinical Data Isolation)
// ------------------------------------------------------

model CounselingSession {
  id            String        @id @default(uuid())
  reservationId String        @unique
  reservation   Reservation   @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  clientId      String
  client        User          @relation("ClientSessions", fields: [clientId], references: [id], onDelete: Cascade)
  counselorId   String
  counselor     User          @relation("CounselorSessions", fields: [counselorId], references: [id], onDelete: Cascade)
  status        String        @default("SCHEDULED")
  startedAt     DateTime?
  endedAt       DateTime?
  clinicalNotes String?       @db.Text
  clientSummary String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([clientId])
  @@index([counselorId])
}

// ------------------------------------------------------
// INDEPENDENT ASSESSMENT MODULE
// (Strict Rule: Independent from Counseling Workflow)
// ------------------------------------------------------

model Assessment {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  answers    Json
  results    Json
  crisisFlag Boolean   @default(false)
  reviewedAt DateTime?
  reviewedBy String?
  staffNotes String?   @db.Text
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([crisisFlag])
}

// ------------------------------------------------------
// PAYMENTS & TRANSACTIONS
// ------------------------------------------------------

model Payment {
  id            String        @id @default(uuid())
  orderNumber   String        @unique
  reservationId String        @unique
  reservation   Reservation   @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  amount        Int
  status        PaymentStatus @default(PENDING)
  paymentMethod String        @default("GATEWAY")
  payload       Json?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([orderNumber])
  @@index([status])
}

// ------------------------------------------------------
// CHAT MODULE (Real-Time 1-to-1)
// ------------------------------------------------------

model ChatMessage {
  id        String   @id @default(uuid())
  sessionId String
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([senderId])
}

// ------------------------------------------------------
// AUDIT LOGS & COMPLIANCE
// ------------------------------------------------------

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  payload   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}
