# Database Configuration (PostgreSQL via Prisma)
DATABASE_URL="postgresql://curhati_user:curhati_password@localhost:5432/curhati_db?schema=public"

# Redis & BullMQ
REDIS_HOST="localhost"
REDIS_PORT=6379

# JWT Authentication
JWT_SECRET="curhati-super-secret-jwt-key-2026"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="curhati-super-secret-refresh-key-2026"
JWT_REFRESH_EXPIRES_IN="30d"

# Server Port
PORT=4000
NODE_ENV="development"

# Payment Gateways (Optional integrations)
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxx"
XENDIT_SECRET_KEY="xnd_development_xxxx"
STRIPE_SECRET_KEY="sk_test_xxxx"

# Private Object Storage (AWS S3 / GCP Storage / MinIO)
STORAGE_BUCKET="curhati-private-reports"
STORAGE_REGION="ap-southeast-1"
